{
  "name": "@vsdiff/github",
  "version": "0.0.1",
  "private": true,
  "description": "GitHub PR source, outbox publisher and comment import — every call through the `gh` CLI.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --out-dir dist"
  },
  "dependencies": {
    "@vsdiff/core": "workspace:*",
    "@vsdiff/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
